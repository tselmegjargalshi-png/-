# NOMAD BUSINESS, орчны хувьсагчид.
# Дараахыг .env.local болгон хуулж утгыг нь өөрчилнө. Жинхэнэ нууц утгыг репод хэзээ ч commit хийж болохгүй.

# --- Өгөгдлийн сан ---
# Хоосон орхивол апп хөтөч болон серверийн санах ой дотор PGlite (WASM Postgres) ашиглан
# үзүүлэнгийн өгөгдөлтэйгээр ажиллана (сервер дахин асахад өгөгдөл шинэчлэгдэнэ).
# Бодит ажиллагаанд PostgreSQL холболтын хаяг оруулна (Supabase, Neon, Railway, ...).
DATABASE_URL=
# PGlite-ийг файлд хадгалах бол замыг оруулна (заавал биш). Жишээ: ./.data/pglite
PGLITE_DIR=
DATABASE_POOL_MAX=5

# --- Нэвтрэлт ---
# Cookie-ийн JWT гарын үсэг. Урт, санамсаргүй утга. Жишээ нь: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# --- Анхны өгөгдөл ---
# Демо данс (admin@example.com, owner@example.com, user@example.com) нэг нууц үгтэй үүснэ.
# Бодит сайтад SEED_DEMO_ACCOUNTS=false болгож, ADMIN_EMAIL, ADMIN_PASSWORD-ийг заавал өөрөө тохируулна.
DEMO_PASSWORD=nomad2026
SEED_DEMO_ACCOUNTS=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# false бол npm run db:setup үед seed алгасна
SEED_DATABASE=true

# --- Модерац ---
# true бол шинээр бүртгүүлсэн бизнес админ баталтал газрын зураг дээр гарахгүй
MODERATE_NEW_BUSINESSES=false

# --- Сайт ---
# Нийтийн домайн (sitemap, canonical, OpenGraph-д ашиглана)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
